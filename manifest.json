{
  "manifest_version": 3,
  "name": "SimpleNewTab",
  "version": "3.0.0",
  "description": "Replace the default new tab with custom shortcuts and backgrounds !",
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
